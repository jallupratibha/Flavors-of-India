{
  "name": "flavors-of-india",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Explore India's regional food on an interactive map. React + Vite front end, Node + Express API.",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": "node --watch server/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"server/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
